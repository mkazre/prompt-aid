# Copy this to `.env` on the cPanel server and fill in the blanks.
# See DEPLOYMENT.md at the repo root for the full step-by-step guide.

APP_NAME="Prompt Aid"
APP_ENV=production
APP_KEY=                        # generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://promptaid.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel MySQL database — create via cPanel "MySQL Databases", then fill in
# the generated names below (cPanel prefixes both the DB and user with your
# account username, e.g. cpaneluser_promptaid).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_promptaid
DB_USERNAME=cpaneluser_promptaid
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.promptaid.co.za

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database        # processed via cron, see DEPLOYMENT.md — shared hosting has no persistent queue worker

CACHE_STORE=database

# Real SMTP — cPanel's own mail service works, or use Sendgrid/Mailgun/SES.
MAIL_MAILER=smtp
MAIL_HOST=mail.promptaid.co.za
MAIL_PORT=587
MAIL_USERNAME=noreply@promptaid.co.za
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@promptaid.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum: browser + mobile app both need to be recognised as trusted origins.
SANCTUM_STATEFUL_DOMAINS=promptaid.co.za,www.promptaid.co.za

VITE_APP_NAME="${APP_NAME}"
